#!/usr/bin/env bash
# Wrapper: runs metatropics_cli.samplesheet (repo root = three levels above this file).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# submission -> assets -> nf-metatropics -> Metatropics repo root
REPO_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"

usage() {
  cat >&2 <<'EOF'
Usage: metatropics-samplesheet [-i DIR] [-o FILE.csv]
       metatropics-samplesheet [DIR]

Build samplesheet.csv for Metatropics FASTQ input (columns: sample, barcode).

Prefer: from repo root run "pip install -e ." — then use "metatropics-samplesheet" from PATH.

This script works without pip: it runs Python with PYTHONPATH set to the clone root.

  -i, --input DIR   Directory of FASTQ files (default: .)
  -o, --output FILE Default: DIR/samplesheet.csv
  -h, --help
EOF
}

INPUT=""
OUTPUT=""
POSITIONAL=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    -i|--input) INPUT="${2:-}"; shift 2 ;;
    -o|--output) OUTPUT="${2:-}"; shift 2 ;;
    -*)
      echo "Unknown option: $1" >&2
      usage
      exit 1
      ;;
    *)
      POSITIONAL+=("$1")
      shift
      ;;
  esac
done

if [[ -z "$INPUT" && ${#POSITIONAL[@]} -gt 0 ]]; then
  INPUT="${POSITIONAL[0]}"
fi
if [[ -z "$INPUT" ]]; then
  INPUT="."
fi

if [[ ! -d "$INPUT" ]]; then
  echo "Not a directory: $INPUT" >&2
  exit 1
fi
INPUT="$(cd "$INPUT" && pwd)"

if [[ ! -d "$REPO_ROOT/metatropics_cli" ]]; then
  echo "Could not find metatropics_cli under repo root: $REPO_ROOT" >&2
  exit 1
fi

export PYTHONPATH="$REPO_ROOT"
if [[ -n "$OUTPUT" ]]; then
  exec python3 -m metatropics_cli.samplesheet -i "$INPUT" -o "$OUTPUT"
else
  exec python3 -m metatropics_cli.samplesheet -i "$INPUT"
fi
