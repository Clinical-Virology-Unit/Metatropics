/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/metatropics Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Global default params, used in configs
params {
    // TO DO nf-core: Specify your pipeline's command line flags
    input_dir                  = null
    //input_fastq              = null
    //output_dir               = null
    basecall                   = null
    model                      = 'hac'  // Default model for basecalling (fast, hac, or sup)
    minLength                  = 200
    usegpu                     = null
    Human_host_fasta           = null
    Other_host_fasta           = null
    Host                       = null
    fasta                      = null        // Deprecated alias for Human_host_fasta
    host_fasta	               = null        // Deprecated alias for Other_host_fasta
    //samplecsv                = null
    nrdb                       = null
    //trim                     = false
    pair                       = false
    quality                    = 7
    depth                      = 5
    agreement                  = 0.7
    //adapters                   = null
    front                      = 0
    tail                       = 0
    // rcoverage_figure removed (Virasign HTML already includes coverage reporting)
    kit_name                   = null

    // Input options
    input                      = null

    // References
    genome                     = null
    igenomes_base              = 's3://ngi-igenomes/igenomes'
    igenomes_ignore            = false
   // Rarefaction parameters
    perform_rarefaction        = false
    target_bases               = 1000000000

   // Virasign (required in the current pipeline)
   run_virasign               = true
   virasign_database          = null   // -d / --database  (e.g. 'RVDB', 'RefSeq', 'RVDB,RefSeq')
   virasign_rvdb_version      = null   // --rvdb-version   (e.g. '31.0')
   virasign_db_dir            = null   // --db-dir (default in VIRASIGN process: <repo>/Databases)
   virasign_accessions        = null   // -a / --accession (extra accessions)
   virasign_ultrasensitive    = false  // -u / --ultrasensitive
   virasign_min_identity      = null   // --min_identity
   virasign_min_mapped_reads  = null   // --min_mapped_reads
   virasign_coverage_depth    = null   // --coverage_depth
   virasign_coverage_breadth  = null   // --coverage_breadth
   virasign_min_nogr          = null   // --min-nogr
   virasign_no_html           = false  // --no-html
   virasign_no_gzip_fastq     = false  // --no-gzip-fastq
   virasign_zscore            = null   // --zscore
   virasign_zscore_controls   = null   // --zscore-controls (path to water FASTQs)
   virasign_threads           = null   // -t / --threads   (default: task cpus)
   virasign_ram_gb            = null   // -r / --ram        (minimap2 -I GB)
   virasign_blind             = null   // -b / --blind      (blinding list path)
   virasign_enable_clustering = false  // --enable-clustering
   virasign_cluster_identity  = null   // --cluster_identity
   virasign_nextclade         = null   // --nextclade / --no-nextclade
   virasign_nextclade_dataset = null   // --nextclade-dataset
   virasign_orthopox_human_only = null // --orthopox-human-only
   virasign_max_ambiguous_fraction = null // --max-ambiguous-fraction
   virasign_keep_endogenous   = false  // --keep-endogenous
   virasign_container         = null   // override container tag/digest

    // Boilerplate options
    outdir                     = null
    publish_dir_mode           = 'copy'
    monochrome_logs            = false
    help                       = false
    version                    = false
    validate_params            = true
    show_hidden_params         = false
    schema_ignore_params       = 'genomes,Human_host_fasta,Other_host_fasta,host_fasta,fasta,perform_rarefaction,target_bases,kit_name,calcua_gpu_slurm_partition,calcua_gpu_cluster_options,run_virasign,virasign_database,virasign_rvdb_version,virasign_db_dir,virasign_accessions,virasign_ultrasensitive,virasign_min_identity,virasign_min_mapped_reads,virasign_coverage_depth,virasign_coverage_breadth,virasign_min_nogr,virasign_no_html,virasign_no_gzip_fastq,virasign_zscore,virasign_zscore_controls,virasign_threads,virasign_ram_gb,virasign_blind,virasign_enable_clustering,virasign_cluster_identity,virasign_nextclade,virasign_nextclade_dataset,virasign_orthopox_human_only,virasign_max_ambiguous_fraction,virasign_keep_endogenous,virasign_container'
    
    // Config options
    custom_config_version      = 'master'
    custom_config_base         = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    config_profile_description = null
    config_profile_contact     = null
    config_profile_url         = null
    config_profile_name        = null


    // Max resource options
    // Defaults only, expecting to be overwritten
    max_memory                 = '64.GB'
    max_cpus                   = 16
    max_time                   = '240.h'

}

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

// Load nf-core custom profiles from different Institutions
try {
    includeConfig "${params.custom_config_base}/nfcore_custom.config"
} catch (Exception e) {
    System.err.println("WARNING: Could not load nf-core/config profiles: ${params.custom_config_base}/nfcore_custom.config")
}

// Load nf-core/metatropics custom profiles from different institutions.
// Warning: Uncomment only if a pipeline-specific instititutional config already exists on nf-core/configs!
// try {
//   includeConfig "${params.custom_config_base}/pipeline/metatropics.config"
// } catch (Exception e) {
//   System.err.println("WARNING: Could not load nf-core/config/metatropics profiles: ${params.custom_config_base}/pipeline/metatropics.config")
// }


profiles {
    debug { process.beforeScript = 'echo $HOSTNAME' }
    // CalcUA (VSC Antwerp): `vsc_calcua` is an alias for the CPU profile (backward compatible).
    vsc_calcua     { includeConfig 'conf/vsc_calcua_cpu.config' }
    vsc_calcua_cpu { includeConfig 'conf/vsc_calcua_cpu.config' }
    vsc_calcua_gpu { includeConfig 'conf/vsc_calcua_gpu.config' }
    conda {
        conda.enabled          = true
        docker.enabled         = false
        singularity.enabled    = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
    }
    mamba {
        conda.enabled          = true
        conda.useMamba         = true
        docker.enabled         = false
        singularity.enabled    = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
    }
	docker {
	docker.enabled         = true
        docker.remove = true
        removeContainer = true
        docker.runOptions       = '--gpus all -u $(id -u):$(id -g)'
    }
    arm {
        docker.runOptions = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
    }
    podman {
        podman.enabled         = true
        docker.enabled         = false
        singularity.enabled    = false
        shifter.enabled        = false
        charliecloud.enabled   = false
    }
    shifter {
        shifter.enabled        = true
        docker.enabled         = false
        singularity.enabled    = false
        podman.enabled         = false
        charliecloud.enabled   = false
    }
    charliecloud {
        charliecloud.enabled   = true
        docker.enabled         = false
        singularity.enabled    = false
        podman.enabled         = false
        shifter.enabled        = false
    }
    gitpod {
        executor.name          = 'local'
        executor.cpus          = 16
        executor.memory        = 60.GB
    }
    test      { includeConfig 'conf/test.config'      }
    test_full { includeConfig 'conf/test_full.config' }
}


// Load igenomes.config if required
if (!params.igenomes_ignore) {
    includeConfig 'conf/igenomes.config'
} else {
    params.genomes = [:]
}


// Export these variables to prevent local Python/R libraries from conflicting with those in the container
// The JULIA depot path has been adjusted to a fixed path `/usr/local/share/julia` that needs to be used for packages in the container.
// See https://apeltzer.github.io/post/03-julia-lang-nextflow/ for details on that. Once we have a common agreement on where to keep Julia packages, this is adjustable.

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
}

// Capture exit codes from upstream processes when piping
process.shell = ['/bin/bash', '-euo', 'pipefail']

def trace_timestamp = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')
timeline {
    enabled = params.outdir ? true : false
    file    = "${params.outdir}/Summary/pipeline_info/execution_timeline_${trace_timestamp}.html"
}
report {
    enabled = params.outdir ? true : false
    file    = "${params.outdir}/Summary/pipeline_info/execution_report_${trace_timestamp}.html"
}
trace {
    enabled = params.outdir ? true : false
    file    = "${params.outdir}/Summary/pipeline_info/execution_trace_${trace_timestamp}.txt"
}
dag {
    enabled = params.outdir ? true : false
    file    = "${params.outdir}/Summary/pipeline_info/pipeline_dag_${trace_timestamp}.html"
}

manifest {
    name            = 'nf-core/metatropics'
    author          = """Antonio Mauro Rezende"""
    homePage        = 'https://github.com/nf-core/metatropics'
    description     = """Analyze Nanopore metagenomic data (fast5/fastq) to identify virus pathogen."""
    mainScript      = 'main.nf'
    nextflowVersion = '!>=22.10.1'
    version         = '0.0.7'
    doi             = ''
}

// Load modules.config for DSL2 module specific options
includeConfig 'conf/modules.config'

// Function to ensure that resource requirements don't go beyond
// a maximum limit
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) {
            println "   ### ERROR ###   Max memory '${params.max_memory}' is not valid! Using default value: $obj"
            return obj
        }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else
                return obj
        } catch (all) {
            println "   ### ERROR ###   Max time '${params.max_time}' is not valid! Using default value: $obj"
            return obj
        }
    } else if (type == 'cpus') {
        try {
            return Math.min( obj, params.max_cpus as int )
        } catch (all) {
            println "   ### ERROR ###   Max cpus '${params.max_cpus}' is not valid! Using default value: $obj"
            return obj
        }
    }
}
