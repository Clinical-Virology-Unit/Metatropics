{
    "$schema": "http://json-schema.org/draft-07/schema",
    "$id": "https://raw.githubusercontent.com/nf-core/metatropics/master/nextflow_schema.json",
    "title": "nf-core/metatropics pipeline parameters",
    "description": "Analyze Nanopore metagenomic data (POD5/FASTQ) to identify viral pathogens and generate summary reports.",
    "type": "object",
    "definitions": {
        "input_output_options": {
            "title": "FASTQ start (basecalled reads)",
            "type": "object",
            "fa_icon": "fas fa-terminal",
            "description": "To autogenerate a `samplesheet.csv` from a reads folder, run `pip install .` once at the repo root, then `metatropics-samplesheet -i .` from your FASTQ directory.",
            "required": ["outdir"],
            "properties": {
                "input": {
                    "type": "string",
                    "format": "file-path",
                    "mimetype": "text/csv",
                    "pattern": "^\\S+\\.csv$",
                    "schema": "assets/samplesheet_schema/schema_input.json",
                    "description": "Path to the samplesheet CSV (example: `fastq.csv`).",
                    "help_text": "Samplesheet CSV (columns: sample, barcode). FASTQ mode: barcode is a full path to FASTQ(.gz). POD5 mode: barcode is a barcode label (e.g. barcode01).",
                    "fa_icon": "fas fa-file-csv"
                },
                "outdir": {
                    "type": "string",
                    "format": "directory-path",
                    "description": "Output directory for results.",
                    "fa_icon": "fas fa-folder-open"
                }
            }
        },
        
        "basecalling_options": {
            "title": "POD5 start (basecalling inside the pipeline)",
            "type": "object",
            "fa_icon": "fas fa-microchip",
            "description": "",
            "properties": {
                "input": {
                    "type": "string",
                    "format": "file-path",
                    "mimetype": "text/csv",
                    "pattern": "^\\S+\\.csv$",
                    "schema": "assets/samplesheet_schema/schema_input.json",
                    "description": "Path to the samplesheet CSV (example: `POD5.csv`).",
                    "fa_icon": "fas fa-file-csv"
                },
                "input_dir": {
                    "type": "string",
                    "default": "None",
                    "description": "Input directory with POD5.",
                    "fa_icon": "fas fa-folder-open"
                },
                "outdir": {
                    "type": "string",
                    "format": "directory-path",
                    "description": "Output directory for results. Use absolute paths.",
                    "fa_icon": "fas fa-folder-open"
                },
                "model": {
                    "type": "string",
                    "default": "hac",
                    "enum": ["fast", "hac", "sup"],
                    "description": "Dorado model (`fast`, `hac`, or `sup`).",
                    "fa_icon": "fas fa-sliders-h"
                },
                "kit_name": {
                    "type": "string",
                    "default": "TWIST-96A-UDI",
                    "description": "Dorado `--kit-name`.",
                    "fa_icon": "fas fa-barcode",
                    "enum": [
                        "EXP-NBD103","EXP-NBD104","EXP-NBD114","EXP-NBD114-24","EXP-NBD196","EXP-PBC001","EXP-PBC096","SQK-16S024","SQK-16S114-24","SQK-LWB001","SQK-MLK111-96-XL","SQK-MLK114-96-XL","SQK-NBD111-24","SQK-NBD111-96",
                        "SQK-NBD114-24","SQK-NBD114-96","SQK-PBK004","SQK-PCB109","SQK-PCB110",
                        "SQK-PCB111-24","SQK-PCB114-24","SQK-RAB201","SQK-RAB204","SQK-RBK001",
                        "SQK-RBK004","SQK-RBK110-96","SQK-RBK111-24","SQK-RBK111-96",
                        "SQK-RBK114-24","SQK-RBK114-96","SQK-RLB001","SQK-RPB004",
                        "SQK-RPB114-24","TWIST-16-UDI","TWIST-96A-UDI","VSK-PTC001",
                        "VSK-VMK001","VSK-VMK004","VSK-VPS001","TWIST-96B-UDI","TWIST-96C-UDI",
                        "TWIST-96D-UDI"
                    ]
                }
            }
        },
        "read_processing_options": {
            "title": "Read processing options",
            "type": "object",
            "fa_icon": "fas fa-stream",
            "description": "Read filtering / trimming thresholds used by the pipeline.",
            "properties": {
                "minLength": {
                    "type": "integer",
                    "default": 200,
                    "description": "Min read length to analyse.",
                    "fa_icon": "fas fa-ruler-horizontal"
                },
                "quality": {
                    "type": "integer",
                    "default": 15,
                    "description": "Min base quality for consensus.",
                    "fa_icon": "fas fa-star-half-alt"
                },
                "agreement": {
                    "type": "number",
                    "default": 0.7,
                    "description": "Min base frequency for consensus calls.",
                    "fa_icon": "fas fa-percentage"
                },
                "depth": {
                    "type": "integer",
                    "default": 25,
                    "description": "Min per-position depth for consensus.",
                    "fa_icon": "fas fa-layer-group"
                },
                "front": {
                    "type": "integer",
                    "default": 25,
                    "description": "Bases to trim at 5′.",
                    "fa_icon": "fas fa-cut"
                },
                "tail": {
                    "type": "integer",
                    "default": 25,
                    "description": "Bases to trim at 3′.",
                    "fa_icon": "fas fa-cut"
                }
            }
        },
        "rarefaction_options": {
            "title": "Rarefaction options",
            "type": "object",
            "fa_icon": "fas fa-compress",
            "description": "Optional subsampling by target bases per sample.",
            "properties": {
                "rarefaction": {
                    "type": "boolean",
                    "default": true,
                    "description": "Rarefy each sample to number of bases.",
                    "fa_icon": "fas fa-toggle-on"
                },
                "target_bases": {
                    "type": "number",
                    "default": 500000000,
                    "description": "Rarefying (default 5×10⁸).",
                    "help_text": "",
                    "fa_icon": "fas fa-bullseye"
                }
            }
        },
        "host_depletion_option": {
            "title": "Host depletion option",
            "type": "object",
            "fa_icon": "fas fa-user-shield",
            "description": "Configure human and optional additional host background subtraction.",
            "properties": {
                "Human_host_fasta": {
                    "type": "string",
                    "format": "file-path",
                    "mimetype": "text/plain",
                    "pattern": "^\\S+\\.fn?a(sta)?(\\.gz)?$",
                    "description": "Optional FASTA for the human background removal step.",
                    "fa_icon": "far fa-file-code"
                },
                "Other_host_fasta": {
                    "type": "string",
                    "format": "file-path",
                    "mimetype": "text/plain",
                    "pattern": "^\\S+\\.fn?a(sta)?(\\.gz)?$",
                    "description": "Optional FASTA for an additional host background.",
                    "fa_icon": "far fa-file-code"
                },
                "Host": {
                    "type": "string",
                    "description": "Optional host keyword(s) for auto-download FASTA.",
                    "help_text": "",
                    "fa_icon": "fas fa-dna"
                }
            }
        },
        "viral_classifier_options_virasign": {
            "title": "Viral classifier options (Virasign)",
            "type": "object",
            "fa_icon": "fas fa-virus",
            "description": "Options controlling Virasign database prep and viral classification.",
            "properties": {
                "virasign_database": {
                    "type": "string",
                    "default": "RVDB",
                    "description": "Database(s) (e.g., `RVDB,RefSeq`).",
                    "help_text": "Comma-separated list of Virasign database labels.",
                    "fa_icon": "fas fa-database"
                },
                "virasign_db_dir": {
                    "type": "string",
                    "description": "Databases location (defaults: `Databases/`).",
                    "help_text": "",
                    "fa_icon": "fas fa-folder-open"
                },
                "virasign_ultrasensitive": {
                    "type": "boolean",
                    "default": false,
                    "description": "Enable Virasign ultrasensitive mode.",
                    "fa_icon": "fas fa-search-plus"
                },
                "virasign_blind": {
                    "type": "string",
                    "description": "Blind viral species from analysis.",
                    "help_text": "",
                    "fa_icon": "fas fa-eye-slash"
                },
                "virasign_rvdb_version": {
                    "type": "string",
                    "description": "RVDB release to use (optional).",
                    "fa_icon": "fas fa-tag"
                },
                "virasign_accessions": {
                    "type": "string",
                    "description": "Extra accessions to include (optional).",
                    "help_text": "",
                    "fa_icon": "fas fa-list"
                },
                "virasign_min_identity": {
                    "type": "number",
                    "description": "Min alignment identity threshold (optional).",
                    "fa_icon": "fas fa-percentage"
                },
                "virasign_min_mapped_reads": {
                    "type": "integer",
                    "description": "Min mapped reads to report a hit (optional).",
                    "fa_icon": "fas fa-filter"
                },
                "virasign_coverage_depth": {
                    "type": "integer",
                    "description": "Min depth for cov filtering (optional).",
                    "fa_icon": "fas fa-layer-group"
                },
                "virasign_coverage_breadth": {
                    "type": "number",
                    "description": "Min breadth for coverage filtering (optional).",
                    "fa_icon": "fas fa-ruler-horizontal"
                },
                "virasign_min_nogr": {
                    "type": "integer",
                    "description": "Min non-overlapping genomic regions (optional).",
                    "fa_icon": "fas fa-project-diagram"
                },
                "virasign_zscore": {
                    "type": "string",
                    "description": "Enable/disable z-score filtering (optional).",
                    "help_text": "",
                    "fa_icon": "fas fa-chart-line"
                },
                "virasign_zscore_controls": {
                    "type": "string",
                    "description": "Negative controls for Z-score: samplesheet sample IDs and/or FASTQ paths (comma-separated or file). Replaces auto-detect. Needs >=2 controls.",
                    "help_text": "Example: H20_1,H20_2,BG_1,BG_2 (names from samplesheet.csv / POD5.csv). Works for FASTQ, fastq_pass, and POD5 modes.",
                    "fa_icon": "fas fa-file"
                },
                "virasign_threads": {
                    "type": "integer",
                    "description": "Threads (optional; defaults to task CPUs).",
                    "fa_icon": "fas fa-microchip"
                },
                "virasign_ram_gb": {
                    "type": "integer",
                    "description": "Minimap2 RAM/GB hint (`-I`) for Virasign (optional).",
                    "fa_icon": "fas fa-memory"
                },
                "virasign_enable_clustering": {
                    "type": "boolean",
                    "default": false,
                    "description": "Clustering of database.",
                    "fa_icon": "fas fa-compress-arrows-alt"
                },
                "virasign_cluster_identity": {
                    "type": "number",
                    "description": "Clustering identity threshold (optional).",
                    "fa_icon": "fas fa-percentage"
                },
                "virasign_max_ambiguous_fraction": {
                    "type": "number",
                    "description": "Max ambiguous % when preparing DB (optional).",
                    "fa_icon": "fas fa-exclamation-triangle"
                }
            }
        },
        "variant_calling_options": {
            "title": "Variant calling and consensus",
            "type": "object",
            "fa_icon": "fas fa-dna",
            "description": "Options for Clair3 per-virus haploid variant calling and uniform post-processing.",
            "properties": {
                "clair3_model": {
                    "type": "string",
                    "description": "Override model(e.g. r1041_e82_400bps_hac_v500).",
                    "help_text": "",
                    "fa_icon": "fas fa-brain"
                },
                "clair3_min_mq": {
                    "type": "integer",
                    "default": 15,
                    "description": "Min mapping quality (MAPQ).",
                    "fa_icon": "fas fa-map-marked-alt"
                },
                "clair3_min_bq": {
                    "type": "integer",
                    "default": 15,
                    "description": "Min base quality.",
                    "fa_icon": "fas fa-signal"
                },
                "clair3_min_alt_reads": {
                    "type": "integer",
                    "default": 10,
                    "description": "Min ALT-supporting reads.",
                    "fa_icon": "fas fa-layer-group"
                },
                "major_vaf": {
                    "type": "number",
                    "default": 0.2,
                    "description": "Major tier: VAF ≥ this value.",
                    "fa_icon": "fas fa-percentage"
                },
                "minor_vaf_min": {
                    "type": "number",
                    "default": 0.03,
                    "description": "Minor lower bound for VAF.",
                    "fa_icon": "fas fa-percentage"
                },
                "minor_vaf_max": {
                    "type": "number",
                    "default": 0.2,
                    "description": "Minor upper bound for VAF.",
                    "fa_icon": "fas fa-percentage"
                },
                "min_sb_pvalue": {
                    "type": "number",
                    "default": 0,
                    "description": "Min ALT strand-bias p-value.",
                    "fa_icon": "fas fa-balance-scale"
                },
                "sb_min_alt_strand": {
                    "type": "integer",
                    "default": 100,
                    "description": "If ALT_F and ALT_R are ≥ this value.",
                    "fa_icon": "fas fa-arrows-alt-h"
                }
            }
        },
        "fastq_pass_options": {
            "title": "fastq_pass start (on-device basecalled, demultiplex inside the pipeline)",
            "type": "object",
            "fa_icon": "fas fa-dna",
            "description": "Use when basecalling was done on the sequencer or in the lab and reads are not yet demultiplexed.",
            "properties": {
                "input": {
                    "type": "string",
                    "format": "file-path",
                    "mimetype": "text/csv",
                    "pattern": "^\\S+\\.csv$",
                    "schema": "assets/samplesheet_schema/schema_input.json",
                    "description": "Path to the samplesheet CSV (example: `POD5.csv`).",
                    "fa_icon": "fas fa-file-csv"
                },
                "input_dir": {
                    "type": "string",
                    "description": "Path to the fastq_pass folder with combined basecalled reads (not yet demultiplexed).",
                    "fa_icon": "fas fa-folder-open"
                },
                "basecall": {
                    "type": "boolean",
                    "default": false,
                    "description": "Must be false to skip pipeline basecalling and demultiplex only.",
                    "fa_icon": "fas fa-toggle-off"
                },
                "outdir": {
                    "type": "string",
                    "format": "directory-path",
                    "description": "Output directory for results.",
                    "fa_icon": "fas fa-folder-open"
                },
                "kit_name": {
                    "type": "string",
                    "default": "TWIST-96A-UDI",
                    "description": "Dorado `--kit-name`.",
                    "fa_icon": "fas fa-barcode"
                }
            }
        }
    },
    "allOf": [
        {
            "$ref": "#/definitions/input_output_options"
        },
        {
            "$ref": "#/definitions/basecalling_options"
        },
        {
            "$ref": "#/definitions/fastq_pass_options"
        },
        {
            "$ref": "#/definitions/read_processing_options"
        },
        {
            "$ref": "#/definitions/rarefaction_options"
        },
        {
            "$ref": "#/definitions/host_depletion_option"
        },
        {
            "$ref": "#/definitions/variant_calling_options"
        },
        {
            "$ref": "#/definitions/viral_classifier_options_virasign"
        }
    ]
}
