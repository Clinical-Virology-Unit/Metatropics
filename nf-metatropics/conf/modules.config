/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: CUSTOM_DUMPSOFTWAREVERSIONS {
        publishDir = [
            path: { "${params.outdir}/pipeline_info" },
            mode: params.publish_dir_mode,
            pattern: '*_versions.yml'
        ]
    }

    withName: CLEANUP {
        publishDir = [ enabled: false ]
    }

    withName: CLEANUP_INTERMEDIATE {
        publishDir = [ enabled: false ]
    }

    withName: FASTP {
        ext.args = "-f '${params.front}' -t '${params.tail}' -e '${params.quality}' -q '${params.quality}' -l '${params.minLength}' --low_complexity_filter"
    }

    withName: MINIMAP2_ALIGN {
        // Host alignments are intermediate; published outputs are nohuman/nohost FASTQs
        publishDir = [ enabled: false ]
        ext.args = "-ax map-ont"
    }

    withName: SAMTOOLS_hFASTQ{
        publishDir = [
            path: { "${params.outdir}/nohuman" },
            mode: params.publish_dir_mode,
            pattern: '*.fastq.gz'
        ]
        ext.args = "-f 4"
    }

    withName: SAMTOOLS_hoFASTQ{
        publishDir = [
            path: { "${params.outdir}/nohost" },
            mode: params.publish_dir_mode,
            pattern: '*.fastq.gz'
        ]
        ext.args = "-f 4"
    }

    withName: SAMTOOLS_SORT {
        // Sorted host BAMs stay in work/; not needed alongside nohuman/nohost FASTQs
        publishDir = [ enabled: false ]
        ext.prefix = { "${meta.id}.sorted" }
    }

    withName: METAMAPS_MAP{
        ext.args = "-m '${params.minLength}' -r '${params.dbmeta}/DB.fa'"
    }

    withName: METAMAPS_CLASSIFY{
        ext.args = "--DB '${params.dbmeta}'"
        // Note: The script now handles exit 134 gracefully by using existing .EM files
        // So we allow the process to finish even if metamaps crashes, as long as output exists
    }

    withName: R_METAPLOT {
        // Plot/report TSVs are consumed from work/; PDFs need not clutter outdir
        publishDir = [ enabled: false ]
        ext.args = "${params.minVirus} ${params.horizontal_coverage}"
    }

    withName: BAM_READCOUNT {
        // Optional per-position stats; not consumed downstream—keep in work/ only
        publishDir = [ enabled: false ]
    }

    withName: REF_FASTA {
        // Intermediate refs stay in work/ only; published references are under reffix/
        publishDir = [ enabled: false ]
        ext.args = "'${params.dbmeta}/DB.fa' ${params.minVirus}"
    }

    withName: IVAR_CONSENSUS{
        ext.args2 = "-aa -A -d 0 -Q 0"
        ext.args = "-q '${params.quality}' -t '${params.agreement}' -m '${params.depth}'"
    }

    withName: HOMOPOLISH_POLISHING{
        ext.args = "-m R10.3.pkl"
    }

    withName: SAMTOOLS_COVERAGE {
        // Raw `samtools coverage` text is only input to ADDING_DEPTH; merged tables are in addingDepth/
        publishDir = [ enabled: false ]
    }

    withName: ADDING_DEPTH{
        publishDir = [
            path: { "${params.outdir}/addingDepth" },
            mode: params.publish_dir_mode,
        ]
    }
}
