/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Results are grouped under outdir:
      Basecalling/   — POD5 Dorado (optional)
      Reads/         — QC, trimming, host depletion
      Classification/ — MetaMaps
      Viral_reads/   — per-virus extracted FASTQs
      Variant_calling/ — references, Medaka, depth tables
      Consensus/     — iVar, Homopolish
      Summary/       — final tables, read_count, rcoverage, pipeline_info
    Any process without an explicit rule falls back to Other/<process-prefix>/
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {

    publishDir = [
        path: { "${params.outdir}/Other/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: CUSTOM_DUMPSOFTWAREVERSIONS {
        publishDir = [
            path: { "${params.outdir}/Summary/pipeline_info" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: CLEANUP {
        publishDir = [ enabled: false ]
    }

    withName: CLEANUP_INTERMEDIATE {
        publishDir = [ enabled: false ]
    }

    withName: SAMPLESHEET_CHECK_METATROPICS {
        publishDir = [
            path: { "${params.outdir}/Summary/pipeline_info" },
            mode: params.publish_dir_mode,
            pattern: 'samplesheet.valid.csv'
        ]
    }

    withName: FIX_NAMES {
        publishDir = [
            path: { "${params.outdir}/Reads/fix" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: RAREFACTION {
        publishDir = [
            path: { "${params.outdir}/Reads/rarefaction" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: FASTP {
        publishDir = [
            path: { "${params.outdir}/Reads/fastp" },
            mode: params.publish_dir_mode,
        ]
        ext.args = "-f '${params.front}' -t '${params.tail}' -e '${params.quality}' -q '${params.quality}' -l '${params.minLength}' --low_complexity_filter"
    }

    withName: NANOPLOT {
        publishDir = [
            path: { "${params.outdir}/Reads/nanoplot" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: DORADO_ONT {
        publishDir = [
            path: { "${params.outdir}/Basecalling/basecalling" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: DORADO_DEMULTIPLEXING {
        publishDir = [
            path: { "${params.outdir}/Basecalling/demultiplexing" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: MINIMAP2_ALIGN {
        publishDir = [ enabled: false ]
        ext.args = "-ax map-ont"
    }

    withName: SAMTOOLS_hFASTQ {
        publishDir = [
            path: { "${params.outdir}/Reads/nohuman" },
            mode: params.publish_dir_mode,
            pattern: '*.fastq.gz'
        ]
        ext.args = "-f 4"
    }

    withName: SAMTOOLS_hoFASTQ {
        publishDir = [
            path: { "${params.outdir}/Reads/nohost" },
            mode: params.publish_dir_mode,
            pattern: '*.fastq.gz'
        ]
        ext.args = "-f 4"
    }

    withName: SAMTOOLS_SORT {
        publishDir = [ enabled: false ]
        ext.prefix = { "${meta.id}.sorted" }
    }

    withName: METAMAPS_MAP {
        publishDir = [
            path: { "${params.outdir}/Classification/metamaps" },
            mode: params.publish_dir_mode,
        ]
        ext.args = "-m '${params.minLength}' -r '${params.dbmeta}/DB.fa'"
    }

    withName: METAMAPS_CLASSIFY {
        publishDir = [
            path: { "${params.outdir}/Classification/metamaps" },
            mode: params.publish_dir_mode,
        ]
        ext.args = "--DB '${params.dbmeta}'"
    }

    withName: R_METAPLOT {
        publishDir = [ enabled: false ]
        ext.args = "${params.minVirus} ${params.horizontal_coverage}"
    }

    withName: SEQTK_SUBSEQ {
        publishDir = [
            path: { "${params.outdir}/Viral_reads/seqtk" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: REFFIX_FASTA {
        publishDir = [
            path: { "${params.outdir}/Variant_calling/reffix" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: MEDAKA {
        publishDir = [
            path: { "${params.outdir}/Variant_calling/medaka" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: BAM_READCOUNT {
        publishDir = [ enabled: false ]
    }

    withName: REF_FASTA {
        publishDir = [ enabled: false ]
        ext.args = "'${params.dbmeta}/DB.fa' ${params.minVirus}"
    }

    withName: IVAR_CONSENSUS {
        publishDir = [
            path: { "${params.outdir}/Consensus/ivar" },
            mode: params.publish_dir_mode,
        ]
        ext.args2 = "-aa -A -d 0 -Q 0"
        ext.args = "-q '${params.quality}' -t '${params.agreement}' -m '${params.depth}'"
    }

    withName: HOMOPOLISH_POLISHING {
        publishDir = [
            path: { "${params.outdir}/Consensus/homopolish" },
            mode: params.publish_dir_mode,
        ]
        ext.args = "-m R10.3.pkl"
    }

    withName: SAMTOOLS_COVERAGE {
        publishDir = [ enabled: false ]
    }

    withName: ADDING_DEPTH {
        publishDir = [
            path: { "${params.outdir}/Variant_calling/addingDepth" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: FINAL_REPORT {
        publishDir = [
            path: { "${params.outdir}/Summary/final" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: RCOVERAGE {
        publishDir = [
            path: { "${params.outdir}/Summary/rcoverage" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: ReadCount {
        publishDir = [
            path: { "${params.outdir}/Summary" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                def fn = filename.toString()
                if (fn.endsWith('read_counts.csv') || fn.endsWith('read_distribution.pdf')) {
                    return fn
                }
                return null
            }
        ]
    }
}
